# Required for database-backed pages and API routes (server-only)
MONGODB_URI=mongodb+srv://username:password@example.invalid/database
MONGODB_DATABASE=blog_portfolio

# Required to enable administrator authentication (server-only; configure both)
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_hash_generated_by_npm_run_auth_hash
SESSION_SECRET=replace_with_at_least_32_random_characters

# Canonical public origin. Set Production to https://holoncom-blog.vercel.app.
# Local development defaults to http://localhost:3000.
# Vercel Preview uses https://$VERCEL_URL. Production falls back to
# https://$VERCEL_PROJECT_PRODUCTION_URL when SITE_URL is absent.
SITE_URL=http://localhost:3000

# Optional durable login throttling (required to enable admin login in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server-signed Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Giscus public identifiers
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Optional verified public links
NEXT_PUBLIC_GITHUB_URL=https://github.com/DenGian
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/ian-mondelaers/

# E2E_MONGODB_URI is CI/test-runner input, not application configuration. When
# set, it must be a credential-free mongodb://127.0.0.1 or localhost server URI
# with no database name. Never point it at Atlas or an application database.
